guid: 8d44ee1f-6f20-4093-b3f2-51638a3e8f57
liveboard:
  name: Chasm Trap Example
  description: "An educational Liveboard demonstrating chasm trap models, bridge tables, and common pitfalls when working with mixed-grain data. Learn how daily sales and monthly forecast data can be properly joined while avoiding data fan-out issues."
  visualizations:
  - id: Viz_1
    viz_guid: 31ebb71a-d603-4991-b58a-b9fba79a0ff4
    note_tile:
      html_parsed_string: "<h2 class=\"theme-module__editor-h2\"><span style=\"white-space: pre-wrap;\">What is a Chasm Trap?</span></h2><p class=\"theme-module__editor-paragraph\"><span style=\"white-space: pre-wrap;\">A chasm trap occurs when two fact tables are joined through a shared dimension, but operate at different levels of granularity. Without proper handling, this creates a many-to-many relationship that causes data to fan out incorrectly.</span></p><h2 class=\"theme-module__editor-h2\"><span style=\"white-space: pre-wrap;\">The Solution: Bridge Tables</span></h2><p class=\"theme-module__editor-paragraph\"><span style=\"white-space: pre-wrap;\">Bridge tables align the grain between fact tables by creating a common level of aggregation. In this model:</span></p><ul class=\"theme-module__editor-ul\"><li value=\"1\" class=\"theme-module__editor-list-item\"><b><strong class=\"theme-module__editor-text-bold\" style=\"white-space: pre-wrap;\">Daily Sales</strong></b><span style=\"white-space: pre-wrap;\"> - Transaction-level data (daily grain)</span></li><li value=\"2\" class=\"theme-module__editor-list-item\"><b><strong class=\"theme-module__editor-text-bold\" style=\"white-space: pre-wrap;\">Monthly Forecast</strong></b><span style=\"white-space: pre-wrap;\"> - Planning data (monthly grain)</span></li><li value=\"3\" class=\"theme-module__editor-list-item\"><b><strong class=\"theme-module__editor-text-bold\" style=\"white-space: pre-wrap;\">Bridge Table</strong></b><span style=\"white-space: pre-wrap;\"> - Aligns both to a shared monthly grain</span></li></ul><p class=\"theme-module__editor-paragraph\"><br><img id=\"a569798b-7ede-4b5f-8a79-ff0a1e7f3387\" alt=\"UPLOAD\" style=\"height: inherit; width: 68.0944021710712%; max-width: 100%;\"><br></p><p class=\"theme-module__editor-paragraph\"><br></p><div class=\"pinboard-note-tile-module__noteTileBg editor-module__bgNode\" style=\"background-color: revert-layer;\"></div>"
  - id: Viz_2
    viz_guid: c57d4707-17a4-473c-b099-009909b491c4
    note_tile:
      html_parsed_string: |-
        <h2>⚠️ Warning: Mixed Granularity</h2>
        <br>
        <p>When you add a <strong>daily-level column</strong> (like Transaction Date) to a query that includes <strong>monthly Forecast data</strong>, you break the bridge table alignment.</p>
        <p><strong>What Happens:</strong></p>
        <ul>
        <li>The monthly forecast value gets repeated for EVERY day in the month</li>
        <li>If there are 30 days, your forecast appears 30x higher than reality</li>
        <li>Aggregations become meaningless</li>
        </ul>
        <p><strong>[Image B - Insert Grain Mismatch Diagram Here]</strong></p>
        <p><strong>Safe Columns with Forecast:</strong></p>
        <ul>
        <li>Shared Month</li>
        <li>Product Category</li>
        <li>Forecast Product Category</li>
        </ul>
        <p><strong>Dangerous Columns with Forecast:</strong></p>
        <ul>
        <li>Transaction Date</li>
        <li>Transaction ID</li>
        <li>Any daily-grain field</li>
        </ul>
  - id: Viz_3
    viz_guid: 8de5a289-b7f4-4fd4-bed4-99ca0f7be859
    note_tile:
      html_parsed_string: |-
        <h2>⚠️ Warning: Dimension Mismatch</h2>
        <br>
        <p>The <strong>Forecast</strong> in this model is defined at the <strong>Product Category</strong> level only - it does NOT include Store-level detail.</p>
        <p><strong>The Problem:</strong></p>
        <p>When you filter by Store Name:</p>
        <ul>
        <li>Sales correctly filters to that store</li>
        <li>Forecast has NO store dimension - it cannot filter!</li>
        <li>The FULL forecast amount appears against filtered sales</li>
        <li>Variance calculations become completely wrong</li>
        </ul>
        <p><strong>[Image C - Insert Store Filter Risk Diagram Here]</strong></p>
        <p><strong>Safe Filters with Forecast:</strong></p>
        <ul>
        <li>Product Category</li>
        <li>Forecast Month</li>
        </ul>
        <p><strong>Dangerous Filters with Forecast:</strong></p>
        <ul>
        <li>Store Name</li>
        <li>Region</li>
        <li>Store State</li>
        <li>Any store-level attribute</li>
        </ul>
  - id: Viz_4
    answer:
      name: "✅ Correct: Monthly Grain Alignment"
      description: Using Shared Month keeps forecast and sales at the same grain level
      tables:
      - id: Chasm Trap Example
        name: Chasm Trap Example
        fqn: c36244d8-dc06-44ea-9eb5-7d20bdb96334
      search_query: "[Forecast Amount] [Sales] [Shared Month] [Shared Month].monthly"
      answer_columns:
      - name: Month(Shared Month)
      - name: Total Forecast Amount
      - name: Total Sales
      table:
        table_columns:
        - column_id: Month(Shared Month)
          headline_aggregation: MIN-MAX
        - column_id: Total Forecast Amount
          headline_aggregation: SUM
        - column_id: Total Sales
          headline_aggregation: SUM
        ordered_column_ids:
        - Month(Shared Month)
        - Total Forecast Amount
        - Total Sales
        client_state: ""
      chart:
        type: LINE
        chart_columns:
        - column_id: Month(Shared Month)
        - column_id: Total Forecast Amount
        - column_id: Total Sales
        axis_configs:
        - x:
          - Month(Shared Month)
          "y":
          - Total Forecast Amount
          - Total Sales
        client_state: ""
      display_mode: CHART_MODE
    viz_guid: 7839feb0-b6c9-4e41-be1d-a4fe3738cb9c
