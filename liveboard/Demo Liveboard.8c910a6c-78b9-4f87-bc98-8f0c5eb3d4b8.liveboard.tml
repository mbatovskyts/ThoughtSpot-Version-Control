  - id: Viz_40
    answer:
      name: Item Type Sales with Changes
      description: An example of how you can use SVGs and graphics to display the change of metrics on your table. <a href="https://community.thoughtspot.com/customers/s/article/Incorporating-SVG-elements-within-ThoughtSpot/">KB Article Reference</a>.  🔎 means hover cursor for more detail
      tables:
      - id: (Sample) Retail - Apparel
        name: (Sample) Retail - Apparel
        fqn: cd252e5c-b552-49a8-821d-3eadaa049cca
      formulas:
      - id: formula_Count Trend
        name: Count Trend
        expr: "concat ( '<svg viewbox=\"0 0 500 100\" class=\"chart\">\n  <style>\n    .heavy {\n      font: bold 60px sans-serif;\n    }\n  </style>\n  <polyline\n     fill=\"none\"' , if ( [formula_Count Retention Rate] > 1 ) then 'stroke=\"#1cb56c\"' else 'stroke=\"#ff0000\"' , '\n     stroke-width=\"8\"\n     points=\"\n       0,' , to_string ( [formula_Count-5Plot] ) , '\n       100,' , to_string ( [formula_Count-4Plot] ) , '\n       200,' , to_string ( [formula_Count-3Plot] ) , '\n       300,' , to_string ( [formula_Count-2Plot] ) , '\n       400,' , to_string ( [formula_Count-1Plot] ) , '\n     \"\n   />\n <polyline \n     fill=\"none\"' , 'stroke=\"#808080\"' , ' stroke-dasharray=\"8,8\"\n     stroke-width=\"8\"\n     points=\"\n       400,' , to_string ( [formula_Count-1Plot] ) , '\n       500,' , to_string ( [formula_CountMTD-Plot] ) , '\n     \"\n   />\n   <text x=\"80%\" y=\"80%\" class=\"heavy\" text-anchor=\"middle\" stroke=\"#808080\" stroke-width=\"2px\">' , to_string ( [formula_Count-1mo] ) , '\n</text>\n</svg>' , '' )"
        was_auto_generated: false
      - id: formula_Item Type 🔎
        name: Item Type 🔎
        expr: "concat ( '<p title=\"' , 'item type = ' , [item type] , '&#013' , 'last month items sold = ' , to_string ( ( group_sum ( [quantity purchased] , [item type] ) ) ) , '\">' , [item type] , '</p>' )"
        was_auto_generated: false
      - id: formula_Progress Bar
        name: Progress Bar
        expr: "concat ( ' ' , if ( [formula_Change %] > 0.99 ) then ( '🟩🟩🟩🟩 ' ) else if ( [formula_Change %] > 0.75 ) then ( '🟩🟩🟩⬜ ' ) else if ( [formula_Change %] > 0.5 ) then ( '🟩🟩⬜⬜ ' ) else if ( [formula_Change %] > 0.25 ) then ( '🟩⬜⬜⬜ ' ) else if ( [formula_Change %] > 0 ) then ( '⬜⬜⬜⬜ ' ) else if ( [formula_Change %] > - 0.25 ) then ( '🟥⬜⬜⬜ ' ) else if ( [formula_Change %] > - 0.5 ) then ( '🟥🟥⬜⬜ ' ) else if ( [formula_Change %] > - 0.75 ) then ( '🟥🟥🟥⬜ ' ) else if ( [formula_Change %] > - 0.99 ) then ( '🟥🟥🟥🟥 ' ) else ( '🟥🟥🟥🟥 ' ) )"
        was_auto_generated: false
      - id: formula_Sum Trend
        name: Sum Trend
        expr: "concat ( '<svg viewbox=\"0 0 500 100\" class=\"chart\">\n  <style>\n    .heavy {\n      font: bold 60px sans-serif;\n    }\n  </style>\n  <polyline\n     fill=\"none\"' , if ( [formula_Sum Retention Rate] > 1 ) then 'stroke=\"#1cb56c\"' else 'stroke=\"#ff0000\"' , '\n     stroke-width=\"8\"\n     points=\"\n       0,' , to_string ( [formula_Sum-5Plot] ) , '\n       100,' , to_string ( [formula_Sum-4Plot] ) , '\n       200,' , to_string ( [formula_Sum-3Plot] ) , '\n       300,' , to_string ( [formula_Sum-2Plot] ) , '\n       400,' , to_string ( [formula_Sum-1Plot] ) , '\n     \"\n   />\n <polyline \n     fill=\"none\"' , 'stroke=\"#808080\"' , ' stroke-dasharray=\"8,8\"\n     stroke-width=\"8\"\n     points=\"\n       400,' , to_string ( [formula_Sum-1Plot] ) , '\n       500,' , to_string ( [formula_SumMTD-Plot] ) , '\n     \"\n   />\n   <text x=\"80%\" y=\"80%\" class=\"heavy\" text-anchor=\"middle\" stroke=\"#808080\" stroke-width=\"2px\">' , concat ( to_string ( to_integer ( [formula_Sum-1mo] / 1000 ) ) , 'k' ) , '\n</text>\n</svg>' , '' )"
        was_auto_generated: false
      - id: formula_Trend
        name: Trend
        expr: "if ( [formula_Change %] < 0 ) then '🔻' else if ( [formula_Change %] > 0 ) then '⬆' else ' '"
        was_auto_generated: false
      - id: formula_Change %
        name: Change %
        expr: "( [formula_Count-1mo] - [formula_Count-2mo] ) / [formula_Count-2mo]"
        was_auto_generated: false
      - id: formula_Count Retention Rate
        name: Count Retention Rate
        expr: "[formula_Count-1mo] / [formula_Count-2mo]"
        was_auto_generated: false
      - id: formula_Count-1Plot
        name: Count-1Plot
        expr: "abs ( ( ( unique_count_if ( to_string ( [date] , \"%Y-%m\" ) = to_string ( add_months ( now ( ) , - 1 ) , \"%Y-%m\" ) , ( [sales] ) ) - [formula_CountMIN-6mo] ) / [formula_CountRangeFactor] ) - 100 )"
        was_auto_generated: false
      - id: formula_Count-1mo
        name: Count-1mo
        expr: "unique_count_if ( to_string ( [date] , \"%Y-%m\" ) = to_string ( add_months ( now ( ) , - 1 ) , \"%Y-%m\" ) , ( [sales] ) )"
        was_auto_generated: false
