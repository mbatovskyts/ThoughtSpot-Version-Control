          category: CURRENCY
          currencyFormatConfig:
            locale: USD
            unit: NONE
            decimals: 0.0
            toSeparateThousands: true
          isCategoryEditable: true
      - name: Variance Percentage
        format:
          category: PERCENTAGE
          percentageFormatConfig:
            decimals: 2.0
          isCategoryEditable: true
      - name: region
      table:
        table_columns:
        - column_id: Compare Range Sales Value
          show_headline: false
        - column_id: Month(date)
          show_headline: false
        - column_id: Sales Variance
          show_headline: false
        - column_id: Total sales
          show_headline: false
        - column_id: Variance Percentage
          show_headline: false
        - column_id: region
          show_headline: false
        ordered_column_ids:
        - region
        - Month(date)
        - Total sales
        - Compare Range Sales Value
        - Sales Variance
        - Variance Percentage
        client_state: ""
        client_state_v2: "{\"tableVizPropVersion\": \"V1\",\"columnProperties\": [{\"columnId\": \"Total sales\",\"columnProperty\": {\"conditionalFormatting\": {}}},{\"columnId\": \"Compare Range Sales Value\",\"columnProperty\": {\"conditionalFormatting\": {}}},{\"columnId\": \"Sales Variance\",\"columnProperty\": {\"conditionalFormatting\": {\"rows\": [{\"operator\": \"LESS_THAN\",\"value\": \"0\",\"plotAsBand\": false,\"backgroundFormatType\": \"SOLID\",\"solidBackgroundAttrs\": {\"color\": \"#F9B3B9\"},\"comparisonType\": \"VALUE_BASED\",\"lhsColumnId\": \"Sales Variance\",\"isHighlightRow\": true}]}}}]}"
