  - id: Viz_8
    answer:
      name: Period-over-Period Sales Variance Analysis
      tables:
      - id: (Sample) Retail - Apparel
        name: (Sample) Retail - Apparel
        fqn: cd252e5c-b552-49a8-821d-3eadaa049cca
      formulas:
      - id: formula_Sales Variance
        name: Sales Variance
        expr: "sum ( [sales] ) - [formula_Compare Range Sales Value]"
        was_auto_generated: false
      - id: formula_Variance Percentage
        name: Variance Percentage
        expr: "( sum ( [sales] ) - [formula_Compare Range Sales Value] ) / [formula_Compare Range Sales Value]"
        was_auto_generated: false
      - id: formula_Compare Range Sales Value
        name: Compare Range Sales Value
        expr: "group_aggregate ( sum ( [sales] ) / unique count ( start_of_month ( [date] ) ) , query_groups ( ) - { [date] } , query_filters ( ) - { [date] } + { [date] >= [Start Date Parameter] and [date] <= [End Date Parameter] } )"
        was_auto_generated: false
      search_query: "[sales] [formula_Compare Range Sales Value] [formula_Sales Variance] [formula_Variance Percentage] [region] [date].'year to date' [date].monthly [date].'last 12 months' [region].east sort by [date] descending"
      answer_columns:
      - name: Compare Range Sales Value
        format:
          category: CURRENCY
          currencyFormatConfig:
            locale: USD
            unit: NONE
            decimals: 0.0
            toSeparateThousands: true
          isCategoryEditable: true
      - name: Month(date)
        sort_info:
          category: DEFAULT
      - name: Sales Variance
        format:
          category: CURRENCY
          currencyFormatConfig:
            locale: USD
            unit: NONE
            decimals: 0.0
            toSeparateThousands: true
          isCategoryEditable: true
      - name: Total sales
