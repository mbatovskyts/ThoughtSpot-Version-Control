guid: 1a282cb8-d6c5-4335-969b-fd2f4ab9b8c7
liveboard:
  name: Relationship Manager Workbench
  description: "This Liveboard guides Relationship Managers through their daily workflow - from morning portfolio reviews and customer segmentation, through midday credit analysis, to afternoon loan portfolio management."
  visualizations:
  - id: Viz_1
    answer:
      name: Transaction Amount by State
      description: Geo bubble chart of state transactions.
      tables:
      - id: Retail_Banking_Model
        name: Retail_Banking_Model
        fqn: 8a82bfb1-31de-4eac-965c-aee25cd89273
      search_query: "[Transaction_Amount] [State]"
      answer_columns:
      - name: State
      - name: Total Transaction_Amount
      table:
        table_columns:
        - column_id: State
          headline_aggregation: COUNT_DISTINCT
        - column_id: Total Transaction_Amount
          headline_aggregation: SUM
        ordered_column_ids:
        - State
        - Total Transaction_Amount
        client_state: ""
      chart:
        type: GEO_BUBBLE
        chart_columns:
        - column_id: State
        - column_id: Total Transaction_Amount
        axis_configs:
        - x:
          - State
          "y":
          - Total Transaction_Amount
        client_state: ""
      display_mode: CHART_MODE
    viz_guid: 4cd90b13-4376-438b-a166-2d0a6fe4531b
  - id: Viz_2
    answer:
      name: Monthly Customer Count Since Trend
      description: Customer count over time by month.
      tables:
      - id: Retail_Banking_Model
        name: Retail_Banking_Model
        fqn: 8a82bfb1-31de-4eac-965c-aee25cd89273
      search_query: "count [Customer Since] [Customer Since].monthly"
      answer_columns:
      - name: Month(Customer Since)
      - name: Number of Customer Since
      table:
        table_columns:
        - column_id: Month(Customer Since)
          headline_aggregation: MIN-MAX
        - column_id: Number of Customer Since
          headline_aggregation: AVERAGE
        ordered_column_ids:
        - Month(Customer Since)
        - Number of Customer Since
        client_state: ""
      chart:
        type: AREA
        chart_columns:
        - column_id: Month(Customer Since)
        - column_id: Number of Customer Since
        axis_configs:
        - x:
          - Month(Customer Since)
          "y":
          - Number of Customer Since
        client_state: ""
      display_mode: CHART_MODE
    viz_guid: 27833666-fc16-4acf-b384-e42d1396fabc
