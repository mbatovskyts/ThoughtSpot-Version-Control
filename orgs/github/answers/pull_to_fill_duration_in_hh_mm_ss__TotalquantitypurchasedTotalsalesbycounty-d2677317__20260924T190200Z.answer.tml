    "formulas": [
      {
        "expr": "concat ( right ( concat ( '0' , to_string ( floor ( [formula_Fill Duration Secs] / 3600 ) ) ) , 2 ) , ':' , right ( concat ( '0' , to_string ( mod ( floor ( [formula_Fill Duration Secs] / 60 ) , 60 ) ) ) , 2 ) , ':' , right ( concat ( '0' , to_string ( mod ( [formula_Fill Duration Secs] , 60 ) ) ) , 2 ) )",
        "id": "formula_Fill Duration",
        "name": "Fill Duration",
        "was_auto_generated": false
      },
      {
        "expr": "diff_time ( [formula_Fill Time] , [formula_Pull Time] )",
        "id": "formula_Fill Duration Secs",
        "name": "Fill Duration Secs",
        "was_auto_generated": false
      },
      {
        "expr": "add_seconds ( [formula_Pull Time] , mod ( day_number_of_year ( [date] ) * 613 + strlen ( [store] ) * 91 , 14400 ) )",
        "id": "formula_Fill Time",
        "name": "Fill Time",
        "was_auto_generated": false
      },
      {
        "expr": "add_seconds ( [date] , mod ( day_number_of_year ( [date] ) * 1447 + strlen ( [store] ) * 37 , 43200 ) )",
        "id": "formula_Pull Time",
        "name": "Pull Time",
        "was_auto_generated": false
      }
    ],
