guid: 1277592f-16a9-4f7d-8ffc-88970f6bd18c
table:
  name: FACT_RETAPP_SALES
  db: RETAILAPPAREL
  schema: PUBLIC
  db_table: FACT_RETAPP_SALES_NEW
  connection:
    name: TS Demo Snowflake
    fqn: 572488eb-13f5-4cc5-9d6f-0d20a7fa3c1c
  columns:
  - name: Store ID
    db_column_name: STOREID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: Transaction ID
    db_column_name: SALESID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: SKU
    db_column_name: PRODUCTID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: Quantity
    db_column_name: QUANTITYPURCHASED
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
    db_column_properties:
      data_type: INT64
  - name: Item Price
    db_column_name: ITEMPRICE
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      is_additive: true
    db_column_properties:
      data_type: DOUBLE
  - name: Sales
    db_column_name: SALES
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      currency_type:
        iso_code: USD
    db_column_properties:
      data_type: DOUBLE
  - name: Transaction Date
    db_column_name: RECORDDATE
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      format_pattern: "MMM dd, yyyy"
    db_column_properties:
      data_type: DATE
  joins_with:
  - name: C_DIM_RETAPP_PRODUCTS
    destination:
      name: DIM_RETAPP_PRODUCTS
      fqn: ad7d476f-1be7-42da-8f25-816af6ee5d16
    "on": "[FACT_RETAPP_SALES::SKU] = [DIM_RETAPP_PRODUCTS::SKU]"
    type: OUTER
  - name: C_DIM_RETAPP_STORES
    destination:
      name: DIM_RETAPP_STORES
      fqn: 8cd69308-f086-4751-bb1d-ad487e7f503b
    "on": "[FACT_RETAPP_SALES::Store ID] = [DIM_RETAPP_STORES::Store ID]"
    type: OUTER
  properties:
    spotter_config:
      is_spotter_enabled: true
