guid: 471d09b4-b3c5-4259-85bb-044fea4cd442
model:
  name: Data Masking With Views Example
  description: This worksheet provides a comprehensive overview of sales transactions across various regions and store locations. It includes details about the products sold, such as name, category, and SKU, along with the quantity sold and the price of each item. Additionally, it contains information about the stores, including a protected version of the store name, geographical coordinates, and address details, as well as the specific transaction dates and unique identifiers. (AI generated)
  model_tables:
  - name: FACT_RETAPP_SALES
    fqn: 1277592f-16a9-4f7d-8ffc-88970f6bd18c
    joins:
    - with: DIM_RETAPP_PRODUCTS
      referencing_join: C_DIM_RETAPP_PRODUCTS
    - with: DIM_RETAPP_STORES
      'on': '[FACT_RETAPP_SALES::Store ID] = [DIM_RETAPP_STORES::Store ID]'
      type: INNER
      cardinality: MANY_TO_ONE
  - name: DIM_RETAPP_STORES
    fqn: 8cd69308-f086-4751-bb1d-ad487e7f503b
  - name: DIM_RETAPP_PRODUCTS
    fqn: ad7d476f-1be7-42da-8f25-816af6ee5d16
  - name: Masking Store Name View
    fqn: a71c12cb-8a5d-46c6-bb98-8ed13513b843
    joins:
    - with: DIM_RETAPP_STORES
      'on': '[Masking Store Name View::Store Name] = [DIM_RETAPP_STORES::Store Name]'
      type: RIGHT_OUTER
      cardinality: ONE_TO_ONE
  formulas:
  - id: formula_Protected Store Name
    name: Protected Store Name
    expr: if ( ts_username = to_string ( 91 ) ) then [Masking Store Name View::Store Name]  else to_string ( [Masking Store Name View::Masked Store ID] )
  - id: formula_Transactions
    name: Transactions
    expr: 'unique count ( [FACT_RETAPP_SALES::Transaction ID] ) '
  columns:
  - name: Protected Store Name
    formula_id: formula_Protected Store Name
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Secure Store Name
      - Protected Store Identification
      synonym_type: AUTO_GENERATED
  - name: Transactions
    formula_id: formula_Transactions
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Transaction Id
    column_id: FACT_RETAPP_SALES::Transaction ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      is_hidden: true
  - name: Product Catigory
    column_id: DIM_RETAPP_PRODUCTS::Product Category
    properties:
      column_type: ATTRIBUTE
  - name: Product Name
    column_id: DIM_RETAPP_PRODUCTS::Product Name
    properties:
      column_type: ATTRIBUTE
  - name: Sku
    column_id: DIM_RETAPP_PRODUCTS::SKU
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
  - name: Store Name
    column_id: DIM_RETAPP_STORES::Store Name
    properties:
      column_type: ATTRIBUTE
  - name: Store Latitude
    column_id: DIM_RETAPP_STORES::Store Latitude
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Latitude of Store
      synonym_type: AUTO_GENERATED
  - name: Region
    column_id: DIM_RETAPP_STORES::Region
    properties:
      column_type: ATTRIBUTE
  - name: Store City
    column_id: DIM_RETAPP_STORES::Store City
    properties:
      column_type: ATTRIBUTE
  - name: Store Zip Code
    column_id: DIM_RETAPP_STORES::Store Zip Code
    properties:
      column_type: ATTRIBUTE
      synonyms:
      - Zip Code of Store
      synonym_type: AUTO_GENERATED
  - name: Store State
    column_id: DIM_RETAPP_STORES::Store State
    properties:
      column_type: ATTRIBUTE
  - name: Store Longitude
    column_id: DIM_RETAPP_STORES::Store Longitude
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Longitude of Store
      synonym_type: AUTO_GENERATED
  - name: Store ID
    column_id: DIM_RETAPP_STORES::Store ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
  - name: Store County
    column_id: DIM_RETAPP_STORES::Store County
    properties:
      column_type: ATTRIBUTE
  - name: Sales
    column_id: FACT_RETAPP_SALES::Sales
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Revenue
      - Income
      currency_type:
        iso_code: USD
      synonym_type: AUTO_GENERATED
  - name: Item Price
    column_id: FACT_RETAPP_SALES::Item Price
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Price of Item
      - Item Cost
      is_additive: true
      synonym_type: AUTO_GENERATED
  - name: Transaction Date
    column_id: FACT_RETAPP_SALES::Transaction Date
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
      synonyms:
      - Date of Transaction
      - Transaction Occurrence Date
      format_pattern: MMM dd, yyyy
      synonym_type: AUTO_GENERATED
  - name: Quantity
    column_id: FACT_RETAPP_SALES::Quantity
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
      synonyms:
      - Amount
      - Number
      synonym_type: AUTO_GENERATED
  properties:
    is_bypass_rls: false
    join_progressive: true
    spotter_config:
      is_spotter_enabled: true
