guid: 4995855c-947e-470e-a225-0c9bb1212d53
model:
  name: Nazish - Risk Control Recommendations 1
  description: The worksheet titled "Nazish - Risk Control Recommendations" provides a comprehensive overview of various accounts and their associated risk control measures. It includes detailed information about each account such as account names, numbers, and descriptions, along with specific data on policy enforcement and recommendation statuses. Additionally, the worksheet captures geographical details, segmentations, and financial figures to support risk assessment and decision-making processes. (AI generated)
  model_tables:
  - name: Nazish - Risk Control -Sample data
    fqn: 4158a132-ebc1-471b-b97b-86a50ce61926
  formulas:
  - id: formula_# Accounts
    name: '# Accounts'
    expr: unique count ( [Nazish - Risk Control -Sample data::Acct_Nbr] )
  - id: formula_# Recs
    name: '# Recs'
    expr: unique count ( [Nazish - Risk Control -Sample data::Rec_Key] )
  - id: formula_Active Account Ind
    name: Active Account Ind
    expr: ifnull ( [Nazish - Risk Control -Sample data::Pol_Infrc_Ind_New] , 'N' )
  - id: formula_Formula for parameter
    name: Formula for parameter
    expr: if ( [Drill Down By] = 'Segment' ) then [Nazish - Risk Control -Sample data::Cust_Seg_Name] else if ( [Drill Down By] = 'Subsegment' ) then [Nazish - Risk Control -Sample data::Cust_Sbsgmt_Name] else if ( [Drill Down By] = 'Distribution Branch' ) then [Nazish - Risk Control -Sample data::Dist_Br_Name] else ''
  - id: formula_Location
    name: Location
    expr: concat ( [Nazish - Risk Control -Sample data::Loc] , ',' , [Nazish - Risk Control -Sample data::Loc_City] , ',' , [Nazish - Risk Control -Sample data::Loc_St] , ',' , [Nazish - Risk Control -Sample data::Loc_ZIP] )
  - id: formula_cnt
    name: cnt
    expr: unique count ( [Nazish - Risk Control -Sample data::Rec_Key] )
  - id: formula_fx date
    name: fx date
    expr: to_date ( concat ( month ( [formula_Date Iss Converted] ) , ' ' , year_name ( [formula_Date Iss Converted] ) ) , 'MMMM yyyy' )
  - id: formula_Date Iss Converted
    name: Date Iss Converted
    expr: to_date ( [Nazish - Risk Control -Sample data::Dt_Iss] , 'yyyy-MM-dd' )
  columns:
  - name: Acct Nbr
    column_id: Nazish - Risk Control -Sample data::Acct_Nbr
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
  - name: '# Accounts'
    formula_id: formula_# Accounts
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: '# Recs'
    formula_id: formula_# Recs
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
