  - name: Schema ID
    description: Internal/system-generated identifier for the schema that was in use.
    column_id: QUERY_HISTORY::SCHEMA_ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
  - name: Flag TS Index Query (Count)
    description: Indicator if the query is generated by ThoughtSpot for indexing purposes
    formula_id: formula_Flag TS Index Query (Count)
    properties:
      column_type: ATTRIBUTE
  - name: Flag Spilled to Local Storage
    description: Flag indicating if query results in memory spilled to local storage
    formula_id: formula_Flag Spilled to Local Storage
    properties:
      column_type: ATTRIBUTE
  - name: Time to Compile (secs)
    description: Compilation time (in seconds)
    formula_id: formula_Time to Compile (secs)
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: Quarter
    description: Start Time quarter
    formula_id: formula_Quarter
    properties:
      column_type: ATTRIBUTE
  - name: Static Unit of Credit
    description: static variable to the warehouse credit consumption unit
    formula_id: formula_Static Unit of Credit
    properties:
      column_type: ATTRIBUTE
  - name: Start Time
    description: Statement start time (in the UTC time zone)
    column_id: QUERY_HISTORY::START_TIME
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
  - name: Query Est. Costs
    description: Estimate costs for the query
    formula_id: formula_Query Est. Costs
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: Time to Execute (secs)
    description: Execution time (in seconds)
    formula_id: formula_Time to Execute (secs)
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: Ratio TS Queries
    formula_id: formula_Ratio TS Queries
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Ratio Cloud Queries
    formula_id: formula_Ratio Cloud Queries
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Warehouse Name
    description: Warehouse that the query executed on, if any.
    column_id: QUERY_HISTORY::WAREHOUSE_NAME
    properties:
      column_type: ATTRIBUTE
  - name: Ratio Queued Queries
    formula_id: formula_Ratio Queued Queries
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: User Name
    description: User who issued the query.
    column_id: QUERY_HISTORY::USER_NAME
    properties:
      column_type: ATTRIBUTE
  - name: Query Tag
    description: Query tag set for this statement through the QUERY_TAG session parameter.
    column_id: QUERY_HISTORY::QUERY_TAG
    properties:
      column_type: ATTRIBUTE
  - name: Query Type
    description: DML, query, etc. If the query is currently running, or the query failed, then the query type may be UNKNOWN.
    column_id: QUERY_HISTORY::QUERY_TYPE
    properties:
      column_type: ATTRIBUTE
  - name: Role Name
    description: Role that was active in the session at the time of the query.
    column_id: QUERY_HISTORY::ROLE_NAME
    properties:
      column_type: ATTRIBUTE
  - name: Time Queued Provisioning (secs)
    description: Time (in seconds) spent in the warehouse queue, waiting for the warehouse compute resources to provision, due to warehouse creation, resume, or resize.
    formula_id: formula_Time Queued Provisioning (secs)
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: Query Est. Credits
    description: Estimate credits consumed for the query.
    formula_id: formula_Query Est. Credits
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: Error Code
    description: Error code, if the query returned an error
    column_id: QUERY_HISTORY::ERROR_CODE
    properties:
      column_type: ATTRIBUTE
  - name: Month
    description: 'Start Time month name '
    formula_id: formula_Month
    properties:
      column_type: ATTRIBUTE
  - name: Flag Cloud Services
    formula_id: formula_Flag Cloud Services
    properties:
      column_type: ATTRIBUTE
  - name: Cloud Service Type
    description: Flag indicating that the query was processed by cloud services layer
    formula_id: formula_Cloud Service Type
    properties:
      column_type: ATTRIBUTE
  - name: Hour of Day
    description: Statement start hour of day
    formula_id: formula_Hour of Day
    properties:
      column_type: ATTRIBUTE
  - name: Database ID
    description: Internal/system-generated identifier for the database that was in use.
    column_id: QUERY_HISTORY::DATABASE_ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
  - name: Queued Query Status
    description: Flag indicating that the query was queued
    formula_id: formula_Queued Query Status
    properties:
      column_type: ATTRIBUTE
  - name: Time Queued Overload (secs)
    description: Time (in seconds) spent in the warehouse queue, due to the warehouse being overloaded by the current query workload.
    formula_id: formula_Time Queued Overload (secs)
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: Schema Name
    description: Schema that was in use at the time of the query.
    column_id: QUERY_HISTORY::SCHEMA_NAME
    properties:
      column_type: ATTRIBUTE
  - name: Query Text
    description: query text string
    column_id: QUERY_HISTORY::QUERY_TEXT
    properties:
      column_type: ATTRIBUTE
  - name: Flag TS Index Query
    formula_id: formula_Flag TS Index Query
    properties:
      column_type: ATTRIBUTE
  - name: Time Elapsed (secs)
    description: Elapsed time (in seconds).
    formula_id: formula_Time Elapsed (secs)
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: Execution Status
    description: 'Execution status for the query: success, fail, incident.'
    column_id: QUERY_HISTORY::EXECUTION_STATUS
    properties:
      column_type: ATTRIBUTE
  - name: Query Count
    description: Count of queries
    formula_id: formula_Query Count
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Warehouse Type
    description: Type of the warehouse when this statement executed.
    column_id: QUERY_HISTORY::WAREHOUSE_TYPE
    properties:
      column_type: ATTRIBUTE
  - name: Avg Scanned from Cache
    description: The percentage of data scanned from the local disk cache. The value ranges from 0.0 to 1.0. Multiply by 100 to get a true percentage.
    formula_id: formula_Avg Scanned from Cache
    properties:
      column_type: MEASURE
      aggregation: SUM
  - name: Warehouse ID
    description: Internal/system-generated identifier for the warehouse that was used.
    column_id: QUERY_HISTORY::WAREHOUSE_ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
  - name: Start Date
    description: Statement start date (in the UTC time zone)
    formula_id: formula_Start Date
    properties:
      column_type: ATTRIBUTE
      format_pattern: dd/MM/yyyy
  - name: Rows Produced
    description: Number of rows produced by this statement.
    column_id: QUERY_HISTORY::ROWS_PRODUCED
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Database Name
    description: Database that was in use at the time of the query.
    column_id: QUERY_HISTORY::DATABASE_NAME
    properties:
      column_type: ATTRIBUTE
  - name: Warehouse Size
    description: Size of the warehouse when this statement executed.
    column_id: QUERY_HISTORY::WAREHOUSE_SIZE
    properties:
      column_type: ATTRIBUTE
  - name: Flag TS Index Query (Values)
    description: Indicator if the query is generated by ThoughtSpot for indexing purposes
    formula_id: formula_Flag TS Index Query (Values)
    properties:
      column_type: ATTRIBUTE
  properties:
    is_bypass_rls: false
    join_progressive: true
    spotter_config:
      is_spotter_enabled: true
