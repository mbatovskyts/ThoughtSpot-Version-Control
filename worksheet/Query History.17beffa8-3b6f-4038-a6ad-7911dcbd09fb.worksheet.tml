guid: 17beffa8-3b6f-4038-a6ad-7911dcbd09fb
model:
  name: Query History
  description: The Query History Account Usage view can be used to query Snowflake query history by various dimensions (time range, session, user, warehouse, etc.) within the last 365 days (1 year). Latency for the view may be up to 45 minutes.
  model_tables:
  - name: QUERY_HISTORY
    fqn: 27e76e55-fd36-4f19-934c-56846b04b9d7
  formulas:
  - id: formula_Avg Partitions Scanned
    name: Avg Partitions Scanned
    expr: safe_divide ( sum ( [QUERY_HISTORY::PARTITIONS_SCANNED] ) , sum ( [QUERY_HISTORY::PARTITIONS_TOTAL] ) ) * 100
  - id: formula_Avg Scanned from Cache
    name: Avg Scanned from Cache
    expr: ( [QUERY_HISTORY::PERCENTAGE_SCANNED_FROM_CACHE] * 100 )
  - id: formula_Cloud Service Type
    name: Cloud Service Type
    expr: if ( isnull ( [QUERY_HISTORY::WAREHOUSE_ID] ) ) then 'cloud' else 'non-cloud'
  - id: formula_Flag Spilled to Local Storage
    name: Flag Spilled to Local Storage
    expr: if ( [QUERY_HISTORY::BYTES_SPILLED_TO_LOCAL_STORAGE] > 0 ) then true else false
  - id: formula_Flag Spilled to Remote Storage
    name: Flag Spilled to Remote Storage
    expr: if ( [QUERY_HISTORY::BYTES_SPILLED_TO_REMOTE_STORAGE] > 0 ) then 'spilled remote' else 'memory'
  - id: formula_Hour of Day
    name: Hour of Day
    expr: hour_of_day ( [QUERY_HISTORY::START_TIME] )
  - id: formula_Month
    name: Month
    expr: month ( [QUERY_HISTORY::START_TIME] )
  - id: formula_Quarter
    name: Quarter
    expr: quarter_number ( [QUERY_HISTORY::START_TIME] )
  - id: formula_Query Est. Costs
    name: Query Est. Costs
    expr: '[formula_Query Est. Credits] * [formula_Static Cost per Credit]'
  - id: formula_Query Est. Credits
    name: Query Est. Credits
    expr: safe_divide ( [formula_Time to Execute (secs)] , 360 ) * [formula_Static Unit of Credit]
  - id: formula_Queued Query Status
    name: Queued Query Status
    expr: if ( [QUERY_HISTORY::QUEUED_REPAIR_TIME] > 0 or [QUERY_HISTORY::QUEUED_OVERLOAD_TIME] > 0 or [QUERY_HISTORY::QUEUED_PROVISIONING_TIME] > 0 ) then 'query in queue' else 'query not in queue'
  - id: formula_Ratio Cloud Queries
    name: Ratio Cloud Queries
    expr: safe_divide ( count_if ( [formula_Flag Cloud Services] , [QUERY_HISTORY::QUERY_ID] ) , [formula_Query Count] ) * 100
  - id: formula_Flag Cloud Services
    name: Flag Cloud Services
    expr: if ( isnull ( [QUERY_HISTORY::WAREHOUSE_ID] ) ) then true else false
  - id: formula_Ratio Queued Queries
    name: Ratio Queued Queries
    expr: safe_divide ( count_if ( [formula_Flag Queued Query] , [QUERY_HISTORY::QUERY_ID] ) , [formula_Query Count] ) * 100
  - id: formula_Flag Queued Query
    name: Flag Queued Query
    expr: if ( [QUERY_HISTORY::QUEUED_REPAIR_TIME] > 0 or [QUERY_HISTORY::QUEUED_OVERLOAD_TIME] > 0 or [QUERY_HISTORY::QUEUED_PROVISIONING_TIME] > 0 ) then true else false
  - id: formula_Ratio TS Queries
    name: Ratio TS Queries
    expr: safe_divide ( count_if ( [formula_Flag TS Index Query] , [QUERY_HISTORY::QUERY_ID] ) , [formula_Query Count] ) * 100
  - id: formula_Flag TS Index Query
    name: Flag TS Index Query
    expr: if ( [formula_Flag TS Index Query (Count)] or [formula_Flag TS Index Query (Values)] ) then true else false
  - id: formula_Query Count
    name: Query Count
    expr: count ( [QUERY_HISTORY::QUERY_ID] )
  - id: formula_Start Date
    name: Start Date
    expr: date ( [QUERY_HISTORY::START_TIME] )
  - id: formula_Static Cost per Credit
    name: Static Cost per Credit
    expr: '3'
  - id: formula_Static Unit of Credit
    name: Static Unit of Credit
    expr: if ( [QUERY_HISTORY::WAREHOUSE_SIZE] = 'x-small' ) then 1 else if ( [QUERY_HISTORY::WAREHOUSE_SIZE] = 'small' ) then 2 else if ( [QUERY_HISTORY::WAREHOUSE_SIZE] = 'medium' ) then 4 else if ( [QUERY_HISTORY::WAREHOUSE_SIZE] = 'large' ) then 8 else if ( [QUERY_HISTORY::WAREHOUSE_SIZE] = 'x-large' ) then 16 else if ( [QUERY_HISTORY::WAREHOUSE_SIZE] = '2x-large' ) then 32 else if ( [QUERY_HISTORY::WAREHOUSE_SIZE] = '3x-large' ) then 64 else if ( [QUERY_HISTORY::WAREHOUSE_SIZE] = '4x-large' ) then 128 else 1
  - id: formula_TS Index Query Type
    name: TS Index Query Type
    expr: if ( [formula_Flag TS Index Query (Count)] or [formula_Flag TS Index Query (Values)] ) then 'indexing' else 'non-indexing'
  - id: formula_Flag TS Index Query (Count)
    name: Flag TS Index Query (Count)
    expr: if ( contains ( [QUERY_HISTORY::QUERY_TEXT] , 'select approx_count_distinct' ) ) then true else false
  - id: formula_Flag TS Index Query (Values)
    name: Flag TS Index Query (Values)
    expr: if ( contains ( [QUERY_HISTORY::QUERY_TEXT] , 'true "ca_3"' ) ) then true else false
  - id: formula_Time Elapsed (secs)
    name: Time Elapsed (secs)
    expr: safe_divide ( [QUERY_HISTORY::TOTAL_ELAPSED_TIME] , 1000 )
  - id: formula_Time Queued Overload (secs)
    name: Time Queued Overload (secs)
    expr: safe_divide ( [QUERY_HISTORY::QUEUED_OVERLOAD_TIME] , 1000 )
  - id: formula_Time Queued Provisioning (secs)
    name: Time Queued Provisioning (secs)
    expr: safe_divide ( [QUERY_HISTORY::QUEUED_PROVISIONING_TIME] , 1000 )
  - id: formula_Time to Compile (secs)
    name: Time to Compile (secs)
    expr: safe_divide ( [QUERY_HISTORY::COMPILATION_TIME] , 1000 )
  - id: formula_Time to Execute (secs)
    name: Time to Execute (secs)
    expr: safe_divide ( [QUERY_HISTORY::EXECUTION_TIME] , 1000 )
  - id: formula_Year
    name: Year
    expr: year ( [QUERY_HISTORY::START_TIME] )
  columns:
  - name: Error Message
    description: Error message, if the query returned an error
    column_id: QUERY_HISTORY::ERROR_MESSAGE
    properties:
      column_type: ATTRIBUTE
  - name: Flag Queued Query
    formula_id: formula_Flag Queued Query
    properties:
      column_type: ATTRIBUTE
  - name: Static Cost per Credit
    description: static variable to define the cost per credit
    formula_id: formula_Static Cost per Credit
    properties:
      column_type: MEASURE
      aggregation: AVERAGE
  - name: Session ID
    description: Session that executed the statement.
    column_id: QUERY_HISTORY::SESSION_ID
    properties:
      column_type: ATTRIBUTE
      index_type: DONT_INDEX
  - name: Year
    description: Start Time year
    formula_id: formula_Year
    properties:
      column_type: ATTRIBUTE
  - name: Flag Spilled to Remote Storage
    description: Flag indicating if query results in memory spilled to remote storage
    formula_id: formula_Flag Spilled to Remote Storage
    properties:
      column_type: ATTRIBUTE
  - name: TS Index Query Type
    description: Indicator if the query is generated by ThoughtSpot for indexing purposes
    formula_id: formula_TS Index Query Type
    properties:
      column_type: ATTRIBUTE
  - name: Avg Partitions Scanned
    description: Number of micro-partitions scanned divided by Total micro-partitions of all tables included in this query.
    formula_id: formula_Avg Partitions Scanned
    properties:
      column_type: MEASURE
      aggregation: SUM
      index_type: DONT_INDEX
  - name: Query ID
    description: Internal/system-generated identifier for the SQL statement.
    column_id: QUERY_HISTORY::QUERY_ID
    properties:
      column_type: ATTRIBUTE
      custom_order:
      - 01a153a0-0403-4e84-0000-468542eb834e
